APP_NAME=jalpilot-be
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=jalpilot
DB_PASSWORD=jalpilot_secret
DB_NAME=jalpilot_db
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT & Cookies
JWT_ACCESS_SECRET=change-me-to-a-64-char-random-secret-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
CSRF_SECRET=change-me-to-a-32-char-csrf-secret

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Storage (S3/MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=jalpilot-assets
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Payment Gateway
PAYMENT_PROVIDER=razorpay
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

